target/
# All crates use the repository workspace lockfile.
transports/*/Cargo.lock
.DS_Store
.env
.pglite/
node_modules/
# Generated logs and benchmark reports are uploaded by CI, not source
# artifacts. A log written here while a benchmark runs must not make the
# checkout look modified: the W26 evidence packet rejects a dirty checkout.
/artifacts/
bindings/mount-rs-napi/*.node
bindings/.mount-rs-napi.napi-stage-*/
bindings/.napi-rs-filesystem-reconciliation.*.swp
