{
  "version": 1,
  "mountpoint": "./mnt",
  "transport": "auto",
  "driver": {
    "kind": "splitstore",
    "storage": {
      "metadata": {
        "kind": "tidb",
        "connection": {
          "env": "MOUNT_RS_TIDB_URL"
        },
        "volume_key": "tidb-rustfs-cli-example",
        "durable": true
      },
      "blocks": {
        "kind": "r2",
        "endpoint": "http://127.0.0.1:9878",
        "bucket": "mount-rs-rustfs",
        "prefix": "mount-rs/tidb-rustfs-cli-example",
        "access_key_id": {
          "env": "R2_ACCESS_KEY_ID"
        },
        "secret_access_key": {
          "env": "R2_SECRET_ACCESS_KEY"
        },
        "durable": true
      },
      "chunk_size_bytes": 7,
      "owner": "tidb-rustfs-cli-example"
    }
  }
}
