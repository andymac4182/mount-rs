{
  "version": 1,
  "http": {
    "host": "127.0.0.1",
    "port": 0,
    "max_request_bytes": 8388608,
    "max_response_bytes": 8388608,
    "max_directory_entries": 4096,
    "read_chunk_bytes": 65536,
    "drain_timeout_ms": 5000,
    "max_connections": 256,
    "request_timeout_ms": 30000,
    "drives": [
      {
        "id": "memory",
        "token": {"env": "MOUNT_RS_MEMORY_TOKEN"},
        "driver": {"kind": "memory"}
      },
      {
        "id": "sqlite",
        "token": {"env": "MOUNT_RS_SQLITE_TOKEN"},
        "driver": {
          "kind": "splitstore",
          "storage": {
            "metadata": {"kind": "sqlite", "path": "./state/http-metadata.db"},
            "blocks": {"kind": "sqlite", "path": "./state/http-blocks.db"},
            "chunk_size_bytes": 4096,
            "owner": "demo-http"
          }
        }
      }
    ]
  }
}
