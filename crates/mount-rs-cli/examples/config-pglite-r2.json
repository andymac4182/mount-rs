{
  "version": 1,
  "mountpoint": "./mnt",
  "transport": "auto",
  "driver": {
    "kind": "splitstore",
    "storage": {
      "metadata": {
        "kind": "pglite",
        "connection": {
          "env": "MOUNT_RS_PGLITE_URL"
        },
        "volume_key": "example-volume",
        "durable": false
      },
      "blocks": {
        "kind": "r2",
        "endpoint": "https://account-id.r2.cloudflarestorage.com",
        "bucket": "example-bucket",
        "prefix": "mount-rs/example",
        "access_key_id": {
          "env": "R2_ACCESS_KEY_ID"
        },
        "secret_access_key": {
          "env": "R2_SECRET_ACCESS_KEY"
        },
        "durable": true
      }
    }
  }
}
