{
  "version": 1,
  "driver": {
    "kind": "splitstore",
    "storage": {
      "metadata": {
        "kind": "tidb",
        "connection": {
          "env": "MOUNT_RS_TIDB_URL"
        },
        "volume_key": "<placeholder>",
        "durable": false
      },
      "blocks": {
        "kind": "r2",
        "endpoint": "http://blocks-policy.invalid",
        "bucket": "mount-rs-production-w08",
        "prefix": "volumes/w08",
        "access_key_id": {
          "env": "R2_ACCESS_KEY_ID"
        },
        "secret_access_key": "inline-secret",
        "durable": false
      },
      "chunk_size_bytes": 4194304,
      "owner": "mount-rs-production-w08"
    }
  }
}
