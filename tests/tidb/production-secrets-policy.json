{
  "version": 1,
  "environment_class": "production-like-staging",
  "secret_manager": {
    "kind": "external",
    "identity_mode": "workload-identity",
    "secret_refs": [
      {
        "name": "MOUNT_RS_TIDB_TLS_URL",
        "source": "external-secret-manager"
      },
      {
        "name": "R2_ACCESS_KEY_ID",
        "source": "external-secret-manager"
      },
      {
        "name": "R2_SECRET_ACCESS_KEY",
        "source": "external-secret-manager"
      }
    ],
    "rotation": {
      "max_age_days": 90,
      "overlap_days": 7,
      "revoke_on_failure": true
    },
    "audit": {
      "redaction_required": true,
      "access_log_required": true,
      "retention_days": 90
    },
    "break_glass": {
      "procedure_ref": "docs/W08-operations-runbook.md#credential-failure",
      "two_person": true
    }
  }
}
