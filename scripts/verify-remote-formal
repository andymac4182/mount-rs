#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Each invocation reports the checks and covers of one production decision.
./scripts/cargo-shared kani -p mount-rs-service --harness remote_grant_requires_exact_scope_and_all_claims
./scripts/cargo-shared kani -p mount-rs-service --harness remote_handle_admission_is_fenced_and_bounded
./scripts/cargo-shared kani -p mount-rs-remote-protocol --harness remote_frame_lengths_are_bounded_before_io
./scripts/cargo-shared kani -p mount-rs-remote-protocol --harness remote_readonly_flags_require_explicit_nonmutating_values
./scripts/cargo-shared kani -p mount-rs-service --harness remote_read_grants_cannot_authorize_mutations
./scripts/cargo-shared kani -p mount-rs-service --harness remote_handles_require_exact_drive_and_revision
