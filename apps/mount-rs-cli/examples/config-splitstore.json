{
  "version": 1,
  "mountpoint": "./mnt",
  "transport": "auto",
  "driver": {
    "kind": "splitstore",
    "storage": {
      "metadata": {
        "kind": "sqlite",
        "path": "./state/metadata.db"
      },
      "blocks": {
        "kind": "sqlite",
        "path": "./state/blocks.db"
      },
      "chunk_size_bytes": 65536,
      "owner": "example-writer"
    }
  }
}
