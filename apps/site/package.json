{
  "name": "@mount-rs/site",
  "version": "0.1.0",
  "private": true,
  "description": "The mount-rs project site and API guide",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/restore-binary-assets.mjs && tsc --noEmit",
    "build:vercel": "NITRO_PRESET=vercel vite build && node scripts/restore-binary-assets.mjs && node scripts/configure-vercel-output.mjs && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:routes": "node scripts/test-routes.mjs",
    "test:vercel": "node scripts/test-vercel-output.mjs",
    "verify": "pnpm run build && pnpm run test:routes",
    "verify:vercel": "pnpm run build:vercel && pnpm run test:vercel"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
